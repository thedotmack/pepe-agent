# ElevenLabs API key (server-side only — never exposed to the browser)
ELEVENLABS_API_KEY=sk-...

# ElevenLabs Conversational Agent ID
# Create an agent at https://elevenlabs.io/app/conversational-ai
# Recommended settings:
#   Voice: "Bj9UqZbhQsanLzgalpEG" (southern guy) or any voice you like
#   System prompt: paste the Pepe personality from MemeDeck's lib/pepe/phrases.ts
#   First message: "Sup anon, ready to talk memes?"
ELEVENLABS_AGENT_ID=agent_...

# Pepe Director defaults. The API key stays server-side; the public values only
# let the browser start Director in ElevenLabs mode without slash commands.
ELEVENLABS_DIRECTOR_VOICE_ID=Bj9UqZbhQsanLzgalpEG
ELEVENLABS_DIRECTOR_MODEL_ID=eleven_v3
NEXT_PUBLIC_ELEVENLABS_DIRECTOR_ENABLED=1
NEXT_PUBLIC_ELEVENLABS_DIRECTOR_VOICE_ID=Bj9UqZbhQsanLzgalpEG
NEXT_PUBLIC_ELEVENLABS_DIRECTOR_MODEL_ID=eleven_v3
