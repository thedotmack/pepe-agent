# Pepe-Agent worker environment. Copy to `.env.worker` (gitignored) and fill in.
# Boot-required vars are marked [BOOT]. Others are validated at point-of-use.

# [BOOT] Shared secret for Next.js -> worker HTTP auth (x-agent-secret header).
AGENT_SHARED_SECRET=change-me-to-a-long-random-string

# Custodial Solana keypair. Private key NEVER reaches the browser.
AGENT_WALLET_PRIVATE_KEY_BASE58=
AGENT_WALLET_PUBLIC_KEY=

# Memedeck's Jupiter swap proxy (used by the trade subsystem in Phase 3).
MEMEDECK_JUPITER_PROXY_URL=https://api.memedeck.win/jupiter

# claude-mem MCP daemon coordinates (see claude-mem plugin README).
CLAUDE_MEM_PLUGIN_ROOT=
CLAUDE_MEM_WORKER_PORT=

# Anthropic API for the Claude Agent SDK.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=  # optional override (proxy / staging)

# Solana RPC + network. Defaults to devnet for safety.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# Worker HTTP bind. 127.0.0.1 only — Next.js proxies all browser traffic.
WORKER_PORT=7011
WORKER_BIND=127.0.0.1
